# SenTri environment defaults - tracked in git on purpose.
#
# These are PLACEHOLDERS: no real credentials live here. Drop your live
# Gmail app password / DB password in .env.local (git-ignored) or in the
# server's real environment variables - both override this file.
#
# Loader order (config/email.php): real env vars > .env.local > .env
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SenTri
APP_URL=http://localhost

# Debug mode: enables the standalone debug.php console AND diverts ALL
# outgoing email to logs/mail/*.eml so signup/verification work offline.
# NEVER enable this on a production box.
APP_DEBUG=0
