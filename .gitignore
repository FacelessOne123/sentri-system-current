# SenTri - Git Ignore Rules

# Server / Apache logs - never commit these
*.log
logs/
error_log
access_log

# PHP config with credentials - never commit
config/db_local.php
# NOTE: .env IS tracked (placeholder defaults only). Per-host overrides go
# in .env.local, which stays ignored below.

# Uploaded user files - runtime only
uploads/reports/
uploads/avatars/.gitkeep

# Editor and OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Composer (if ever added)
vendor/
composer.lock

# Environment overrides
.env.local
.env.local.*
!.env.local.example


# Raw Overpass snapshot cache for the address-term build (regenerate with
# `php scripts/build-address-terms.php --fetch`). The processed snapshot
# assets/geo/imus-address-terms.json IS committed.
assets/geo/osm-imus-addresses.json
