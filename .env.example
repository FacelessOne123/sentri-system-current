MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SenTri
APP_URL=http://localhost

# ─── Development / offline mode ───────────────────────────────────────────────
# For LOCALHOST TESTING (Linux Mint / XAMPP / built-in server) set:
#   APP_DEBUG=1    → enables the standalone debug.php console AND diverts ALL
#                    outgoing email (verification, password reset) to
#                    logs/mail/*.eml — signup + email verification then work
#                    fully offline; debug.php lists them with clickable links.
#   MAIL_OUTBOX=1  → force the offline outbox independent of APP_DEBUG.
# NEVER enable either on a production box.
APP_DEBUG=0
# MAIL_OUTBOX=0

# ─── Database credentials (for LAMP/XAMPP where root has a password) ─────────
# db.php falls back to root@socket / DB "sentri" without a password when unset.
# DB_HOST=127.0.0.1
# DB_USER=root
# DB_PASS=yourpass
# DB_NAME=sentri
